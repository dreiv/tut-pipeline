{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": ["/"],
      "numberOfRuns": 1,
      "settings": {
        "chromeFlags": "--headless --no-sandbox --disable-dev-shm-usage --disable-gpu --disable-software-rasterizer"
      }
    },
    "assert": {
      "preset": "lighthouse:recommended",
      "assertions": { "all": "warn" }
    }
  }
}
